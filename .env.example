# ==============================================================================
# AgentArena — Production & Development Environment Configuration
# ==============================================================================

# Core Application Server
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Master Encryption Key (Used for AES-256-GCM encryption of stored agent auth secrets)
# Generate a cryptographically secure 256-bit key in production
AGENTARENA_SECRET_KEY="" # Required: 32 random bytes encoded as 64 hex characters

# Database Persistence (Prisma / PostgreSQL)
# Required for production; PostgreSQL is not yet wired into the current synchronous repositories.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agentarena?schema=public"
CORS_ORIGINS="https://your-frontend.example.com"

# Redis Cache & BullMQ Background Queue
# Used for asynchronous background benchmark run execution and distributed job tracking
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
# Or full connection URL:
# REDIS_URL="redis://:password@127.0.0.1:6379/0"

# Docker Isolated Execution Sandbox
# Path to host Docker daemon socket for secure, non-root, network-isolated code execution
DOCKER_SOCKET="/var/run/docker.sock"
# Required immutable image references (must include @sha256:<64 hex chars>)
AGENTARENA_DOCKER_IMAGE_PYTHON=""
AGENTARENA_DOCKER_IMAGE_NODE=""

# Bifrost Unified Model Gateway (Optional)
# Gateway endpoint and provider authorization token for unified multi-provider LLM benchmarking
BIFROST_ENDPOINT=""
BIFROST_API_KEY=""

# Security & Testing Overrides
# Set to 'false' in production to strictly enforce HTTPS and block private/loopback agent IPs
ALLOW_LOCAL_TEST_AGENTS="false"
